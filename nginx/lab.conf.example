# Salin ke /etc/nginx/sites-available/lab.conf (Debian/Ubuntu) lalu:
#   sudo ln -s /etc/nginx/sites-available/lab.conf /etc/nginx/sites-enabled/lab.conf
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d lab.contoh.com        # menambahkan TLS + redirect HTTP->HTTPS ke blok ini
# Ganti lab.contoh.com dengan domain Anda, dan 3001 dengan WEB_PORT di .env jika berbeda.
# Blok ini berdiri sendiri (server_name berbeda): aplikasi Laravel yang sudah ada tidak tersentuh.

server {
    listen 80;
    listen [::]:80;
    server_name lab.contoh.com;

    # Unggahan dokumen/sertifikat sampai ±14 MB (data URL base64 dari file 10 MB). Default nginx hanya 1 MB.
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # SENGAJA $remote_addr (menimpa), bukan $proxy_add_x_forwarded_for: klien tidak bisa memalsukan IP.
        # Aplikasi meneruskan IP ini ke backend untuk rate limit login (10 gagal/15 menit) dan log aktivitas.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_read_timeout 60s;
    }

    # Perangkat IoT (opsional): hanya jalur ini yang diteruskan ke backend. Perlu `ports` api di docker-compose.yml dibuka.
    # location = /api/v1/monitoring/readings {
    #     proxy_pass http://127.0.0.1:3000;
    #     proxy_set_header Host              $host;
    #     proxy_set_header X-Forwarded-For   $remote_addr;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
}
