# Salin ke .env lalu isi. Jangan di-commit.
# Buat secret:  openssl rand -hex 32   (pakai hex agar aman di URL database)

# URL publik yang dibuka pengguna (tanpa slash akhir). Dipakai untuk isi QR, CORS, tautan email.
# NEXT_PUBLIC_APP_URL ikut tertanam saat build: jika diubah, jalankan `docker compose up -d --build web`.
PUBLIC_URL=https://lab.contoh.com
# Port di 127.0.0.1 tempat nginx host meneruskan trafik ke container web (ubah jika 3001 sudah terpakai).
WEB_PORT=3001
# Hanya untuk profil Caddy (`docker compose --profile caddy up`): nama domain (HTTPS otomatis) atau :80 untuk uji tanpa TLS.
# Diabaikan jika memakai nginx yang sudah ada.
SITE_ADDRESS=lab.contoh.com

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Secret frontend NextAuth (BEDA dari JWT di atas)
AUTH_SECRET=

# Data awal: true = otomatis saat start pertama (database kosong) isi 7 akun, 13 ruangan, 689 alat, 126 alat pendukung.
# false = manual (lihat README-DEPLOY bagian 3). Jika true, SEED_PASSWORD wajib (min. 12 karakter, huruf + angka); berlaku untuk SEMUA akun seed.
SEED_ON_START=false
SEED_PASSWORD=
# Akun admin untuk login pertama. Isi alamat email NYATA (dipakai juga untuk email uji).
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# Email pengingat (opsional)
EMAIL_ENABLED=false
# manual (disarankan) = tidak ada email otomatis; admin memilih penerima lewat Log Email -> "Kirim email pengingat".
# auto = job harian 07:00 mengirim ke semua penerima yang jatuh tempo (email "terlambat" diulang tiap 3 hari).
CALIBRATION_EMAIL_MODE=manual
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lab Equipment <no-reply@contoh.com>"
